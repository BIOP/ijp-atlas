		<!-- ch.epfl.biop:bigdataviewer-biop-tools pulls in ch.epfl.biop:Operetta_Importer
		     and sc.fiji:Stitching_, which are compiled for Java 21, so this build must
		     target 21 as well (the enforcer bytecode rule checks this). -->
		<scijava.jvm.version>21</scijava.jvm.version>

		<!-- Some dependencies (ome:turbojpeg) have classes in the default package,
		     which breaks the module path derivation of the maven-javadoc-plugin.
		     Run javadoc in non-modular (pre-Java 9) mode instead. -->
		<legacyMode>true</legacyMode>

		<!-- NB: Deploy releases to the SciJava Maven repository. -->
		<releaseProfiles>sign,deploy-to-scijava</releaseProfiles>

	</properties>

	<!-- NB: Two workarounds below for damage left by the maven.scijava.org outage
	     (see the SciJava Zulip outage thread). Both can be reverted once the
	     SciJava Nexus is healthy again.

	     1. checksumPolicy=fail on scijava.public: the group serves some artifacts
	        as HTTP 200 with a zero-length body (jar, pom and .sha1 alike), e.g.
	        xml-apis:xml-apis-ext:1.3.04, which Maven otherwise accepts as a valid
	        download and caches, breaking the enforcer ("zip file is empty") and
	        poisoning every local repository and CI cache it touches. Failing on the
	        checksum mismatch makes Maven fall through to the next repository.

	     2. The ome repository: ome:formats-gpl, ome:turbojpeg and
	        org.openmicroscopy:omero-* are no longer served by the scijava.public
	        group at all (jars 404, only previously cached poms come back), because
	        its ome-releases / ome-external proxies are broken. It also acts as the
	        healthy fallback for point 1. -->
	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
			<releases><checksumPolicy>fail</checksumPolicy></releases>
			<snapshots><checksumPolicy>fail</checksumPolicy></snapshots>
		</repository>
		<repository>
			<id>ome</id>
			<url>https://artifacts.openmicroscopy.org/artifactory/maven</url>
		</repository>
	</repositories>

